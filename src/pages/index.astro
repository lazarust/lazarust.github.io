---
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = [
  { href: '/about/', label: 'about.md' },
  { href: '/blog/', label: 'blog' },
];
---

<BaseLayout
  title="~/"
  description="Thomas — data practitioner with 6+ years building production-grade data systems and ML-powered tooling."
>
  <h1 class="sr-only">Thomas' Blog</h1>
  <div class="prompt-line">
    <span class="prompt-user">~</span>
    <span class="prompt-sep">$</span>
    <span class="prompt-cmd">whoami</span>
  </div>
  <p class="intro">
    Thomas — data practitioner with 6+ years building production-grade data systems and ML-powered
    tooling. I write about data engineering, ML, and the tools I use along the way.
  </p>

  <div class="prompt-line">
    <span class="prompt-user">~</span>
    <span class="prompt-sep">$</span>
    <span class="prompt-cmd">ls</span>
  </div>

  <div class="ls-listing">
    {entries.map((entry, index) => (
      <div class="ls-row" style={`--i: ${Math.min(index, 12)}`}>
        <span class="ls-date"></span>
        <span class="ls-size">-</span>
        <a href={entry.href} data-nav-item>
          {entry.label}
        </a>
      </div>
    ))}
  </div>
</BaseLayout>
