---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPublishedPosts, readingTime } from '../../lib/posts';
import { formatPostDate } from '../../lib/dates';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((heading) => heading.depth <= 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
>
  <nav class="nav-links" aria-label="Breadcrumb">
    <a href="/" data-nav-item>
      &larr; home
    </a>{' '}
    <a href="/blog/" data-nav-item>
      &larr; blog
    </a>
    <span aria-current="page">{post.data.title}</span>
  </nav>
  <div class="prompt-line">
    <span class="prompt-user">~/blog</span>
    <span class="prompt-sep">$</span>
    <span class="prompt-cmd">cat {post.id}.md</span>
  </div>
  <article class="post-content">
    <div class="reading-progress" aria-hidden="true"></div>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.date}>{formatPostDate(post.data.date, 'long')}</time>
        <span> · {readingTime(post.body)} min read</span>
      </div>
      {post.data.categories.length > 0 && (
        <ul class="post-categories" aria-label="Categories">
          {post.data.categories.map((category) => (
            <li>
              <a class="tag" href={`/categories/${slugify(category)}/`}>
                {category}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>
    {tocHeadings.length >= 3 && (
      <nav class="post-toc" aria-label="Table of contents">
        <p class="post-toc-label">Contents</p>
        <ul>
          {tocHeadings.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <Content />
  </article>
</BaseLayout>
