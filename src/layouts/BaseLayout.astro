---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '../styles/tokyonight.css';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
}

const { title } = Astro.props;
const siteTitle = title ? `${title} — Thomas' Blog` : "Thomas' Blog";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('tn-theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = saved ?? (prefersLight ? 'day' : 'night');
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'night';
        }
      })();
    </script>
    <ClientRouter />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Thomas' Blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content="Personal blog about data engineering, ML, and tools" />
    <meta property="og:url" content={Astro.url} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      skip to content
    </a>
    <div class="app-shell">
      <main class="editor-pane" id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer" transition:persist="site-footer">
        <nav class="footer-links" aria-label="Social links">
          <a href="https://github.com/lazarust" target="_blank" rel="noopener">
            github
          </a>
          <a href="https://bsky.app/profile/lazarust.bsky.social" target="_blank" rel="noopener">
            bluesky
          </a>
          <a href="https://twitter.com/lazarustda" target="_blank" rel="noopener">
            x
          </a>
          <a href="https://www.linkedin.com/in/td-lazarus" target="_blank" rel="noopener">
            linkedin
          </a>
          <a href="/rss.xml" target="_blank" rel="noopener">
            rss
          </a>
        </nav>
        <p class="footer-hint">
          <button
            type="button"
            class="footer-button"
            aria-haspopup="dialog"
            data-open-palette="search"
          >
            search
          </button>
          <button
            type="button"
            class="footer-button"
            aria-haspopup="dialog"
            data-open-palette="help"
          >
            shortcuts
          </button>
          <span>
            or press <kbd>/</kbd> and <kbd>?</kbd>
          </span>
        </p>
      </footer>
    </div>
    <script>
      import '../lib/keyboard';
    </script>
  </body>
</html>
